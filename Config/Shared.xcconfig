// Shared app-identity and signing defaults, attached to the project as the
// base configuration for both build configurations (Debug and Release).
//
// Contributors: never edit this file or project.pbxproj to sign with your own
// Apple team. Create Config/Local.xcconfig (gitignored) instead — see
// CONTRIBUTING.md ("Code signing for contributors").

DEVELOPMENT_TEAM = 6GYD9C9N6R
APP_IDENTIFIER_SUFFIX =
// HERMEX-FORK: the fork must sign under its own identifier, or iOS reads it as
// the same app as upstream's App Store Hermex and refuses the install beside it.
// Upstream signs as com.uzairansar.hermesmobile, and an
// app is identified by this string alone — sharing it means iOS treats Hermex
// Plus and Hermex as the SAME app, so the two can never be installed side by
// side and an install can be refused as a conflict. Hermex Plus therefore signs
// under this fork's own namespace. Everything else derives from these two
// variables (share extension, live-activity widget, app group, keychain
// service), so nothing else has to be kept in step by hand.
//
// Consequence for existing installs: a new bundle identifier is a new app. The
// first build lands as a fresh install and the previous install keeps working
// until it is deleted; the Keychain access group changes, so the saved server
// URL and password must be entered once more. Server-side data is untouched.
APP_BUNDLE_IDENTIFIER = com.braintimebox.hermexplus$(APP_IDENTIFIER_SUFFIX)
APP_GROUP_IDENTIFIER = group.com.braintimebox.hermexplus$(APP_IDENTIFIER_SUFFIX)

// HERMEX-FORK: the fork must also open its links under a URL scheme of its own.
// Upstream declares `hermes-agent`, and iOS resolves a scheme to ONE app. With
// the App Store Hermex installed beside Hermex Plus both apps claim it, so the
// share extension's request to open `hermes-agent://share` can be handed to the
// App Store app — the share sheet then opens the wrong app's window. A scheme
// from this namespace cannot be claimed by anyone else, which is what makes the
// share round-trip deterministic. Branch builds keep their suffix, as the
// bundle identifier does.
APP_URL_SCHEME_NAME = hermesplus

// Optional per-machine overrides. This include must stay last: later
// assignments win, so Local.xcconfig values override the defaults above.
#include? "Local.xcconfig"
