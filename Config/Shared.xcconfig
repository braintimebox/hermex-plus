// Shared app-identity and signing defaults, attached to the project as the
// base configuration for both build configurations (Debug and Release).
//
// Contributors: never edit this file or project.pbxproj to sign with your own
// Apple team. Create Config/Local.xcconfig (gitignored) instead — see
// CONTRIBUTING.md ("Code signing for contributors").

DEVELOPMENT_TEAM = 6GYD9C9N6R
APP_IDENTIFIER_SUFFIX =
// HERMEX-FORK: the fork's identity (bundle id, app group, URL scheme,
// display name, product name, line) lives in Config/Identity.xcconfig —
// see the long explanation there. Version and build number live in
// Config/Version.xcconfig. Nothing identity-related belongs in this file,
// so a second line is a change to one file, not to the project.

// Optional per-machine overrides. This include must stay last: later
// assignments win, so Local.xcconfig values override the defaults above.
// Version and identity live in their own files so a whole line (stable/test)
// is switched in one place. Order matters: Local.xcconfig stays last.
#include "Version.xcconfig"
#include "Identity.xcconfig"

#include? "Local.xcconfig"
