// HERMEX-FORK: single source of the app version and build number.
//
// Edit THIS file to release a new version — nothing else carries a version
// literal. `MARKETING_VERSION` and `CURRENT_PROJECT_VERSION` in project.pbxproj
// read these two variables (all 16 and 8 occurrences respectively), and the
// `VERSION` file that CI reads is generated from them by
// `scripts/sync-version.py`. A precheck gate fails when the mirror drifts.
//
// Why: the same version used to be typed into VERSION, 16 MARKETING_VERSION
// entries and 8 CURRENT_PROJECT_VERSION entries. A release that bumped one of
// them produced builds whose About screen, file name and CI artifact disagreed.

APP_VERSION = 3.9.74

// Monotonic build number. Keep it a sortable timestamp (YYYYMMDDHHMM) so two
// builds of the same APP_VERSION are still distinguishable in the About screen.
APP_BUILD = 202611071951
